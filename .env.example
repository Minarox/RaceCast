# LiveKit — the WebRTC SFU the car publishes to and the site subscribes to.
# Read at runtime (astro:env server secrets), so these belong in the container's
# environment, never in the image.
LIVEKIT_TLS="true"
LIVEKIT_DOMAIN="example.com"
LIVEKIT_API_KEY="api_key"
LIVEKIT_API_SECRET="api_secret"
LIVEKIT_ROOM="room"
LIVEKIT_PUBLISHER_IDENTITY="identity"

# Unlocks /admin. Unset or empty leaves the page unreachable rather than open.
ADMIN_PASSWORD=""

# SQLite file holding the stage banner and the rally history.
# In Docker this points inside the mounted volume.
DATABASE_PATH="./data/racecast.db"

# Public origin of the site, used for canonical URLs and the sitemap.
SITE_URL="https://racecast.example.com"

# RaceCast-Receiver's rewind HTTP API (RC_REWIND_HTTP_PORT), read straight from
# the browser. It must allow this site's exact origin in its own
# RC_REWIND_HTTP_CORS_ORIGIN, or every request fails as a CORS error.
#
# Read in the browser, so it is inlined at BUILD time: it has to be set when
# `astro build` runs (a build arg in Docker), not only at runtime.
# Leave empty to ship without the rewind controls.
PUBLIC_REWIND_URL=""

# Port the standalone server listens on (defaults to 4321).
PORT="4321"
