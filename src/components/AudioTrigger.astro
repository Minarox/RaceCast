---
import Icon from "@components/Icon.astro"

/**
 * Browsers block audio playback until the page has seen a user gesture.
 * LiveKit reports that as AudioPlaybackStatusChanged(false); this surfaces a
 * single button to collect the gesture, and hides itself once audio runs or
 * when there is no microphone track to play in the first place.
 */
---

<button id="audio-trigger" type="button" class="hidden" aria-label="Activer le son de la diffusion">
    <Icon name="speaker-simple-high" size={16} />
    Activer le son
</button>

<script>
    import type { RemoteTrackPublication } from "livekit-client"
    import { Event, dispatchEvent } from "@types"

    const button = document.getElementById("audio-trigger")!

    let needInteraction: boolean = false
    let hasMicrophone: boolean = false

    function update(): void {
        button.classList.toggle("hidden", !(needInteraction && hasMicrophone))
    }

    button.addEventListener("click", (): void => {
        dispatchEvent(Event.RESUME_AUDIO)
        needInteraction = false
        update()
    })

    document.addEventListener(Event.NEED_USER_INTERACTION, (): void => {
        needInteraction = true
        update()
    })

    document.addEventListener(Event.MICROPHONES, (event: any): void => {
        hasMicrophone = (event.detail as RemoteTrackPublication[]).length > 0
        update()
    })

    dispatchEvent(Event.RESEND, Event.MICROPHONES)
</script>

<style>
    #audio-trigger {
        position: fixed;
        left: 50%;
        bottom: calc(var(--status-h) + var(--rewind-h) + 16px + var(--safe-bottom));
        z-index: 40;
        transform: translateX(-50%);
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 10px 16px;
        border-radius: var(--r-md);
        font: 500 12.5px var(--font);
        color: var(--accent-soft);
        background: rgba(14, 16, 24, 0.82);
        backdrop-filter: blur(10px);
        box-shadow: inset 0 0 0 1px var(--accent-line);
    }
</style>
