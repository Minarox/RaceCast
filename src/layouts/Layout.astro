---
import { SEO } from "astro-seo"
import { AstroFont } from "astro-font"
import Logo from "@assets/logo.svg"
import Banner from "@assets/banner.webp"
import LiveKit from "@components/LiveKit.astro"
import AudioTrigger from "@components/AudioTrigger.astro"
import Plausible from "@components/Plausible.astro"
import "@styles/theme.css"

interface Props {
    /** Page title suffix, e.g. "Télémétrie". Omit on the live page. */
    section?: string
    /** Mount the autoplay unblocker — only pages that play audio need it. */
    audio?: boolean
    /**
     * Open the LiveKit connection. On by default; /admin turns it off, since
     * subscribing to the car's tracks to edit a form would burn bandwidth on
     * exactly the connection the car is competing for.
     */
    connect?: boolean
}

const { section, audio = false, connect = true } = Astro.props

const name: string = "RaceCast"
const title: string = section ? `${name} — ${section}` : name
const description: string = "Diffusion en direct de la voiture de course de Kevin CORBIER."
---

<!doctype html>
<html lang="fr">
    <head>
        <SEO
            title={title}
            description={description}
            charset="UTF-8"
            openGraph={{
                basic: {
                    title,
                    type: "website",
                    url: Astro.url.origin,
                    image: Banner.src
                },
                optional: { locale: "fr_FR" },
                image: {
                    alt: `${name} banner`,
                    url: Banner.src,
                    type: "image/webp"
                }
            }}
            twitter={{
                creator: "@Minarox_",
                card: "summary_large_image",
                site: Astro.url.origin,
                title,
                description,
                image: Banner.src,
                imageAlt: `${name} banner`
            }}
            extend={{
                link: [
                    { rel: "icon", type: "image/svg+xml", href: Logo.src },
                    { rel: "sitemap", href: "/sitemap-index.xml" }
                ],
                meta: [
                    {
                        name: "viewport",
                        content:
                            "width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content"
                    },
                    { name: "theme-color", content: "#0e1018" },
                    { name: "color-scheme", content: "dark" },
                    {
                        name: "keywords",
                        content:
                            "Stream, Rallye, Direct, Compétition, Kévin, Corbier, Voiture, Course, RaceCast, Race, Spéciale"
                    },
                    { name: "robots", content: "index, follow" },
                    { name: "author", content: "Mathis Serrieres Maniecki" }
                ]
            }}
        />

        <AstroFont
            config={[
                {
                    name: "Inter",
                    src: [],
                    googleFontsURL:
                        "https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap",
                    preload: true,
                    fetch: true,
                    cacheDir: ".astro/fonts",
                    display: "swap",
                    selector: "body",
                    fallback: "sans-serif"
                }
            ]}
        />
    </head>

    <body>
        <slot />
        {connect && <LiveKit />}
        {connect && audio && <AudioTrigger />}
        <Plausible />
    </body>
</html>
